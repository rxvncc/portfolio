---
import "../styles/global.css";

const description =
  "Reshad Ahammed Ayon is a web developer based in Dhaka, Bangladesh. Learn more about him, his interests, the story behind his domain name, and how to get in touch.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://rxvn.cc/#website",
      url: "https://rxvn.cc/",
      name: "rxvn",
      alternateName: "Reshad Ahammed Ayon",
    },
    {
      "@type": "ProfilePage",
      url: "https://rxvn.cc/",
      mainEntity: {
        "@type": "Person",
        "@id": "https://rxvn.cc/#person",
        name: "Reshad Ahammed Ayon",
        alternateName: ["Ahmad", "rxvn", "rxvncc"],
        url: "https://rxvn.cc/",
        description: "Web developer from Dhaka, Bangladesh.",
        jobTitle: "Web Developer",
        address: {
          "@type": "PostalAddress",
          addressLocality: "Dhaka",
          addressCountry: "BD",
        },
        knowsAbout: [
          "Free and Open Source Software",
          "Full-Stack Development",
          "Software Development",
          "Web Development",
        ],
        sameAs: ["https://github.com/rxvncc"],
      },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>rxvn.cc</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://rxvn.cc/" />
    <meta name="color-scheme" content="light dark" />

    <!-- Open Graph -->
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="rxvn" />
    <meta property="og:title" content="Reshad Ahammed Ayon (rxvn)" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://rxvn.cc/" />
    <meta property="og:image" content="https://rxvn.cc/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Reshad Ahammed Ayon, Web Developer, rxvn.cc"
    />
    <meta property="profile:first_name" content="Reshad" />
    <meta property="profile:last_name" content="Ahammed Ayon" />
    <meta property="profile:username" content="rxvncc" />

    <!-- Twitter / X (falls back to the Open Graph tags above) -->
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Icons -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Structured data -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(schema)}
    />
  </head>
  <body class="p-6 font-mono bg-white text-black dark:bg-black dark:text-white">
    <header class="max-w-prose">
      <p>
        My name is Reshad Ahammed Ayon, though I prefer to go by Ahmad. I
        inherited the name from my father, but I prefer this spelling because it
        more closely reflects its Arabic origin.
      </p>
    </header>
    <main class="max-w-prose mt-4 space-y-4">
      <p>I'm a web developer based in Dhaka, Bangladesh.</p>
      <p>
        I enjoy learning, exploring ideas, and understanding how things work.
        I'm thoughtful about how I spend my time.
      </p>
      <p>
        If you're wondering about rxvn.cc, rxvn is a numeronym, similar to i18n.
        It uses the first and last letters of my name, with the 15 letters in
        between represented by XV, the Roman numeral for 15. I chose .cc for its
        short length and affordability, bringing the entire domain to just seven
        characters.
      </p>
      <p>
        I try to use rxvncc as my username across platforms. It's simply the
        domain without the dot, making it a convenient alternative when rxvn is
        already taken or periods aren't allowed.
      </p>
      <p>
        I don't currently maintain a blog or an active social media presence. I
        used to, but eventually decided they weren't particularly useful to me.
        They can certainly be valuable for others; I just haven't found a need
        for them.
      </p>
      <p>
        I'm not particularly active on instant messaging platforms. Email is my
        preferred way to communicate.
      </p>
    </main>
    <footer class="mt-4 gap-4 flex flex-col sm:flex-row">
      <a href="mailto:contact@rxvn.cc" class="underline">
        contact@rxvn.cc
      </a>
      <a href="https://github.com/rxvncc" rel="me" class="underline">
        github.com/rxvncc
      </a>
    </footer>
  </body>
</html>
