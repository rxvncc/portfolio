---
import "../styles/global.css";

const schema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  mainEntity: {
    "@type": "Person",
    name: "Reshad Ahammed Ayon",
    alternateName: "rxvn",
    url: "https://rxvn.cc",
    jobTitle: "Software Developer",
    email: "mailto:contact@rxvn.cc",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Dhaka",
      addressCountry: "Bangladesh",
    },
    knowsAbout: ["Software Development", "Web Development"],
    sameAs: ["https://github.com/rxvncc", "https://t.me/rxvncc"],
  },
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="canonical" href="https://rxvn.cc" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta
      name="description"
      content="Reshad Ahammed Ayon - rxvn, software developer."
    />
    <meta name="generator" content={Astro.generator} />
    <title>Reshad Ahammed Ayon - rxvn</title>
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(schema)}
    />
  </head>
  <body class="m-0 min-h-dvh p-6 font-mono text-sm bg-white text-black dark:bg-black dark:text-white">
    <h1 class="font-bold">Reshad Ahammed Ayon</h1>
    <p class="text-neutral-500 dark:text-neutral-400">Software Developer</p>
    <div class="max-w-prose">
      <p class="mt-4">
        <p class="mt-4">
          You can call me Ayon, and I'm from Dhaka, Bangladesh.
        </p>
      </p>
      <p class="mt-4">
        rxvn = r + 15 letters + n, with "xv" being 15 in Roman numerals.
      </p>
    </div>
    <nav class="mt-4 flex gap-3">
      <a href="mailto:contact@rxvn.cc">Email</a>
      <span>/</span>
      <a href="https://t.me/rxvncc">Telegram</a>
      <span>/</span>
      <a href="https://github.com/rxvncc">GitHub</a>
    </nav>
  </body>
</html>
