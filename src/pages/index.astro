---
import "../styles/global.css";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://rxvn.cc/#website",
      url: "https://rxvn.cc/",
      name: "rxvn",
      alternateName: "Reshad Ahammed Ayon",
    },
    {
      "@type": "ProfilePage",
      url: "https://rxvn.cc/",
      mainEntity: {
        "@type": "Person",
        "@id": "https://rxvn.cc/#person",
        name: "Reshad Ahammed Ayon",
        alternateName: ["rxvn", "rxvncc"],
        url: "https://rxvn.cc/",
        description: "Software developer from Dhaka, Bangladesh.",
        jobTitle: "Software Developer",
        address: {
          "@type": "PostalAddress",
          addressLocality: "Dhaka",
          addressCountry: "BD",
        },
        knowsAbout: [
          "Software Development",
          "Web Development",
          "Open Source",
          "JavaScript",
          "TypeScript",
          "Linux",
        ],
        sameAs: ["https://github.com/rxvncc", "https://t.me/rxvncc"],
      },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Reshad Ahammed Ayon (rxvn) - Software Developer</title>
    <meta
      name="description"
      content="Reshad Ahammed Ayon (rxvn) is a software developer from Dhaka, Bangladesh. Find GitHub, Telegram and contact links here."
    />
    <link rel="canonical" href="https://rxvn.cc/" />
    <meta name="color-scheme" content="light dark" />

    <!-- Open Graph -->
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="rxvn" />
    <meta
      property="og:title"
      content="Reshad Ahammed Ayon (rxvn) - Software Developer"
    />
    <meta
      property="og:description"
      content="Software developer from Dhaka, Bangladesh."
    />
    <meta property="og:url" content="https://rxvn.cc/" />
    <meta property="og:image" content="https://rxvn.cc/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Reshad Ahammed Ayon, Software Developer, rxvn.cc"
    />
    <meta property="profile:first_name" content="Reshad" />
    <meta property="profile:last_name" content="Ahammed Ayon" />
    <meta property="profile:username" content="rxvncc" />

    <!-- Twitter / X (falls back to the Open Graph tags above) -->
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Icons -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Structured data -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(schema)}
    />
  </head>
  <body class="m-0 min-h-dvh p-6 font-mono text-sm bg-white text-black dark:bg-black dark:text-white">
    <header>
      <h1 class="font-bold">Reshad Ahammed Ayon</h1>
      <p class="text-neutral-500 dark:text-neutral-400">Software Developer</p>
    </header>
    <main class="max-w-prose">
      <p class="mt-4">
        You can call me Ayon, and I'm from Dhaka, Bangladesh. If you're
        wondering about rxvn: it's a numeronym, like i18n. The r, then 15
        letters, then the n, with the 15 written as xv. The profiles linked
        below use rxvncc, which is just rxvn.cc without the dot.
      </p>
    </main>
    <nav class="mt-4" aria-label="Contact and profiles">
      <ul class="flex gap-3">
        <li>
          <a href="mailto:contact@rxvn.cc">Email</a>
        </li>
        <li>
          <a href="https://t.me/rxvncc" rel="me">
            Telegram
          </a>
        </li>
        <li>
          <a href="https://github.com/rxvncc" rel="me">
            GitHub
          </a>
        </li>
      </ul>
    </nav>
  </body>
</html>
